<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.TaskManager.ViewModels.Elements"
             mc:Ignorable="d" 
             x:DataType="vm:TaskInDashboardViewModel"
             x:Class="AccountingAndAnalytics.TaskManager.Views.Elements.TaskInDashboardView">
    <Border Background="White"
            BorderBrush="#1A3C4D"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            Cursor="Hand">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding DealLabel}"
                           FontSize="10"
                           Foreground="#9FB8C4"/>
                <TextBlock Text="{Binding DealNumber}"
                           FontSize="10"
                           Foreground="#9FB8C4"
                           FontWeight="Medium"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding TaskNumberLabel}"
                           FontSize="10"
                           Foreground="#9FB8C4"/>
                <TextBlock Text="{Binding TaskNumber}"
                           FontSize="10"
                           Foreground="#9FB8C4"
                           FontWeight="Medium"/>
            </StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontSize="12"
                       FontWeight="Medium"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding DeadlineLabel}"
                           FontSize="11"
                           Foreground="#9FB8C4"/>
                <TextBlock Text="{Binding Deadline}"
                           FontSize="11"
                           FontWeight="Medium"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>