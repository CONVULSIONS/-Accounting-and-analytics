<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.TaskManager.ViewModels.Elements"
             mc:Ignorable="d"
             x:DataType="vm:TaskInListViewModel"
             x:Class="AccountingAndAnalytics.TaskManager.Views.Elements.TaskInListView">
    <Grid ColumnDefinitions="*,40" RowDefinitions="*,*">
        <Border CornerRadius="10"
                BorderBrush="#1A3C4D"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                ClipToBounds="True"
                Margin="0,2,0,8"
                Grid.Column="0" Grid.RowSpan="2">
                <Grid>
                    <Button HorizontalAlignment="Stretch"
                            Padding="0"
                            CornerRadius="10"
                            Background="White"
                            Cursor="hand">
                        <Border BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Левая часть: инфо -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <!-- Номер + Название -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Number}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#9FB8C4"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="Medium"/>
                                    </StackPanel>
                                    <!-- Описание -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- Даты -->
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding CreatedDateLabel}"
                                                       FontSize="11"
                                                       Foreground="#9FB8C4"/>
                                            <TextBlock Text="{Binding CreatedDate}"
                                                       FontSize="11"
                                                       Foreground="#6B7280"/> 
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding DeadlineLabel}"
                                                       FontSize="11"
                                                       Foreground="#9FB8C4"/>
                                            <TextBlock Text="{Binding Deadline}"
                                                       FontSize="11"
                                                       Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Правая часть: статус + кнопка -->
                                <StackPanel Grid.Column="1"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Border Background="#E6F1FB"
                                            CornerRadius="12"
                                            Padding="12,4"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="#0C447C"/>
                                    </Border>
                                    <Button Content="{Binding MarkAsDoneLabel}"
                                            Background="#1A3C4D"
                                            Foreground="White"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
        </Border>
        <Button Grid.Column="1" Grid.Row="0"
                Command="{Binding EditCommand}"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="6"
                Background="#1A3C4D"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Cursor="hand">
            <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                      Width="14"
                      Height="14"
                      Foreground="White"/>
        </Button>
        <Button Grid.Column="1" Grid.Row="1"
                Command="{Binding DeleteCommand}"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="6"
                Background="#A32D2D"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Cursor="hand">
            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                      Width="14"
                      Height="14"
                      Foreground="White"/>
        </Button>
    </Grid>
</UserControl>