<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.TaskManager.ViewModels.Pages"
             xmlns:views="using:AccountingAndAnalytics.TaskManager.Views.Elements"
             mc:Ignorable="d"
             x:DataType="vm:DeadlineDashboardPageViewModel"
             x:Class="AccountingAndAnalytics.TaskManager.Views.Pages.DeadlineDashboardPageView">
    <Grid RowDefinitions="Auto,Auto,*" Background="#F4F6F9">

        <!-- Заголовок -->
        <Border Grid.Row="0" Padding="24,20,24,12">
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="22"
                       FontWeight="Medium"/>
        </Border>

        <!-- Шапка колонок -->
        <Grid Grid.Row="1"
              ColumnDefinitions="1*,1*,1*,1*,1*,1*"
              Margin="24,0,24,8">

            <Border Grid.Column="0" Background="#FCEBEB" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding OverdueLabel}" FontSize="12" FontWeight="Medium" Foreground="#A32D2D"/>
            </Border>

            <Border Grid.Column="1" Background="#E1F5EE" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding CompletedLabel}" FontSize="12" FontWeight="Medium" Foreground="#085041"/>
            </Border>

            <Border Grid.Column="2" Background="#1A3C4D" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding WeekLabel}" FontSize="12" FontWeight="Medium" Foreground="White"/>
            </Border>

            <Border Grid.Column="3" Background="#2A5F7A" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding NextWeekLabel}" FontSize="12" FontWeight="Medium" Foreground="White"/>
            </Border>

            <Border Grid.Column="4" Background="#4A8FAD" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding NextMonthLabel}" FontSize="12" FontWeight="Medium" Foreground="White"/>
            </Border>

            <Border Grid.Column="5" Background="#9FB8C4" CornerRadius="8" Padding="12,8">
                <TextBlock Text="{Binding LaterLabel}" FontSize="12" FontWeight="Medium" Foreground="White"/>
            </Border>

        </Grid>

        <!-- Колонки с карточками -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="1*,1*,1*,1*,1*,1*" Margin="24,0,24,24">

                <!-- Просрочено -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Overdue}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Выполнено -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Completed}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- На этой неделе -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Week}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Через неделю -->
                <ItemsControl Grid.Column="3" ItemsSource="{Binding NextWeek}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Через месяц -->
                <ItemsControl Grid.Column="4" ItemsSource="{Binding NextMonth}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Более месяца -->
                <ItemsControl Grid.Column="5" ItemsSource="{Binding Later}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TaskInDashboardView DataContext="{Binding}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>