<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.TaskManager.ViewModels.Pages"
             xmlns:taskViews="using:AccountingAndAnalytics.TaskManager.Views.Elements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1000"
             x:DataType="vm:DealTasksViewModel"
             x:Class="AccountingAndAnalytics.TaskManager.Views.Pages.DealTasksView">
    <ScrollViewer>
        <StackPanel Margin="24,20,24,20" Spacing="16">

            <!-- шапка -->
            <Border Background="#1A3C4D"
                    CornerRadius="10,10,0,0">
                <StackPanel Margin="20,16,20,16" Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}"
                               FontSize="20"
                               FontWeight="Medium"
                               Foreground="White"/>
                    <TextBlock Text="{Binding Number}"
                               FontSize="20"
                               FontWeight="Medium"
                               Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- Основная инфо -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="0,0,10,10"
                    Padding="20,16">
                <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto">

                    <StackPanel Grid.Column="0" Grid.Row="0"
                                Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ClientTitle}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding Client}"
                                   FontSize="13" FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0"
                                Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="{Binding RealEstateTitle}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding RealEstate}"
                                   FontSize="13" FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1"
                                Spacing="4">
                        <TextBlock Text="{Binding PeriodTitle}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding Period}"
                                   FontSize="13" FontWeight="Medium"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Исполнители -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,16">
                <StackPanel Spacing="12">
    <TextBlock Text="{Binding ExecutersTitle}"
               FontSize="10" FontWeight="Medium"
               Foreground="#9FB8C4"/>
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding ClientExecutorLabel}"
                   FontSize="11"
                   Foreground="#9FB8C4"/>
        <TextBlock Text="{Binding ClientExecutor}"
                   FontSize="13"/>
    </StackPanel>
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding LegalExecutorLabel}"
                   FontSize="11"
                   Foreground="#9FB8C4"/>
        <TextBlock Text="{Binding LegalExecutor}"
                   FontSize="13"/>
    </StackPanel>
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding FinanceExecutorLabel}"
                   FontSize="11"
                   Foreground="#9FB8C4"/>
        <TextBlock Text="{Binding FinanceExecutor}"
                   FontSize="13"/>
    </StackPanel>
</StackPanel>
            </Border>
            <Button Grid.Column="1"
                    Content="{Binding btnCreateTitle}"
                    Command="{Binding OpenCreateDialogCommand}"
                    Background="#1A3C4D"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="14,8"
                    FontSize="13"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>

            <!-- Задачи -->
            
                <StackPanel Spacing="0">
                    <Border Background="#1A3C4D"
                            CornerRadius="10,10,0,0"
                            Padding="16,10">
                        <TextBlock Text="{Binding TaskTitle}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                    </Border>
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,10,10"
                            Height="300">
                        <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <taskViews:TaskInListView DataContext="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </ScrollViewer>
                    </Border>
                </StackPanel>
            

            <!-- Комментарии -->
            <StackPanel Spacing="0">
                <Border Background="#1A3C4D"
                        CornerRadius="10,10,0,0"
                        Padding="16,10">
                    <TextBlock Text="{Binding CommentsTitle}"
                               FontSize="10" FontWeight="Medium"
                               Foreground="#9FB8C4"/>
                </Border>
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,10,10">
                    <StackPanel>
    <Border Height="200"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8"
            Margin="14,10">
        <ScrollViewer>
            <StackPanel Spacing="8" Margin="10">

                <!-- Комментарий 1 -->
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Comment1AuthorName}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#1A3C4D"/>
                            <TextBlock Text="{Binding Comment1CreatedAt}"
                                       FontSize="11"
                                       Foreground="#9FB8C4"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Comment1Text}"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Комментарий 2 -->
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Comment2AuthorName}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#1A3C4D"/>
                            <TextBlock Text="{Binding Comment2CreatedAt}"
                                       FontSize="11"
                                       Foreground="#9FB8C4"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Comment2Text}"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>

    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            Padding="14,10">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Watermark="{Binding CommentWatermark}"
                     FontSize="13"
                     CornerRadius="8,0,0,8"/>
            <Button Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Content="{Binding SendButtonLabel}"
                    Background="#1A3C4D"
                    Foreground="White"
                    CornerRadius="0,8,8,0"
                    Padding="14,0"
                    FontSize="12"/>
        </Grid>
    </Border>
</StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
