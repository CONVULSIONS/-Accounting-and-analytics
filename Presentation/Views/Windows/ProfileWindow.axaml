<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AccountingAndAnalytics.Presentation.ViewModels.Windows"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AccountingAndAnalytics.Presentation.Views.Windows.ProfileWindow"
        x:DataType="vm:ProfileViewModel"
        Title="ProfileWindow">

    <Grid ShowGridLines="True" RowDefinitions = "50,1*,2*" ColumnDefinitions="70,*">
        <Viewbox Margin="10,5">
        <Button Content="&lt;- Back"/>
            </Viewbox>
    </Grid>

</Window>
