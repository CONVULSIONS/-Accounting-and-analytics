<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.CRM.ViewModels.Pages"
             xmlns:views="using:AccountingAndAnalytics.CRM.Views.Elements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AccountingAndAnalytics.CRM.Views.Pages.ApplicationPageView"
             x:DataType="vm:ApplicationPageViewModel">

    <Grid Background="#F4F6F9"
          RowDefinitions="Auto,Auto,*,Auto"
          Margin="24,20,24,20">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="Applications"
                       FontSize="22" FontWeight="Medium"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="+ New App"
                    Command="{Binding OpenCreateDialogCommand}"
                    Background="#1A3C4D"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="14,8"
                    FontSize="13"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#1A3C4D"
                CornerRadius="10,10,0,0"
                Padding="0,0,0,0">
            <Grid ColumnDefinitions="130,1*,1*,1*,1*,110">
                <TextBlock/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="0,0,10,10"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Applications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ApplicationInListView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
