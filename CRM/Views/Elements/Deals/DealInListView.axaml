<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.CRM.ViewModels.Elements"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="300"
             x:Class="AccountingAndAnalytics.CRM.Views.Elements.Deals.DealInListView"
             x:DataType="vm:DealInListViewModel">

    <Button HorizontalAlignment="Stretch"
            Padding="0"
            CornerRadius="0"
            Command="{Binding GoToTasksCommand}">
        <Button.Styles>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#F0F6FF"/>
            </Style>
            <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="Background" Value="White"/>
            </Style>
        </Button.Styles>

        <Grid ColumnDefinitions="130,1*,1*,1*,1*,110"
              RowDefinitions="1*,2*"
              HorizontalAlignment="Stretch">

            <!-- Заголовки колонок -->


            <!-- Номер сделки -->
            <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <TextBlock Text="{Binding Number}"
                           FontWeight="Medium"
                           FontSize="13"
                           Foreground="#1A3C4D"/>
            </StackPanel>

            <!-- Данные строки -->
            <TextBlock Grid.Column="1" Grid.Row="1"
                       Text="{Binding RealEstate}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Grid.Row="1"
                       Text="{Binding Client}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Grid.Row="1"
                       Text="{Binding Period}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Grid.Row="1"
                       Text="0"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Статус -->
            <Border Grid.Column="5" Grid.Row="0" Grid.RowSpan="2"
                    Background="#E6F1FB"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Status}"
                           FontSize="11"
                           Foreground="#185FA5"/>
            </Border>
        </Grid>
    </Button>

</UserControl>
