<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.CRM.ViewModels.Elements"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="AccountingAndAnalytics.CRM.Views.Elements.ApplicationInListView"
             x:DataType="vm:ApplicationInListViewModel">


        <Button HorizontalAlignment="Stretch"
            Padding="0"
            CornerRadius="10">
        <Button.Styles>
            <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#F0F6FF"/>
            </Style>
        </Button.Styles>

        <Border CornerRadius="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Левая полоса с номером -->
                <Border Grid.Column="0"
                        Background="#1A3C4D"
                        Width="64"
                        CornerRadius="10,0,0,10">
                    <TextBlock Text="{Binding Number}"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Центр: title, client, realestate -->
                <StackPanel Grid.Column="1"
                            Spacing="4"
                            Margin="16,12,16,12"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="Medium"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Клиент:"
                                   FontSize="12"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding ClientName}"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Объект:"
                                   FontSize="12"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding RealEstateName}"
                                   FontSize="12"/>
                    </StackPanel>

                </StackPanel>

                <!-- Правая часть: статус -->
                <Border Grid.Column="2"
                        Background="#E6F1FB"
                        CornerRadius="12"
                        Padding="12,5"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#0C447C"/>
                </Border>

            </Grid>
        </Border>
    </Button>
</UserControl>
