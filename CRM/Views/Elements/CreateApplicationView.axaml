<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.CRM.ViewModels.Elements"
             mc:Ignorable="d"
             x:DataType="vm:CreateApplicationViewModel"
             x:Class="AccountingAndAnalytics.CRM.Views.Elements.CreateApplicationView"
             CornerRadius="10,10,10,10">

    <ScrollViewer Background="Transparent">
        <Grid RowDefinitions="Auto,*" Background="Transparent" Width="600">

            <!-- Шапка -->
            <Border Grid.Row="0"
                    Background="#1A3C4D"
                    CornerRadius="10,10,0,0">
                <Grid ColumnDefinitions="*,Auto"
                      Margin="20,16,20,16">
                    <TextBlock Grid.Column="0"
                               Text="Создание заявки"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CloseCreateDialogCommand}"
                            Background="Transparent"
                            Foreground="#9FB8C4"
                            FontSize="16"
                            Padding="8,4"/>
                </Grid>
            </Border>

            <!-- Тело -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0,0,10,10">
                <StackPanel Margin="20,16,20,16" Spacing="16">

                    <!-- Примечание -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DescriptionTitle}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding DescriptionText}"
                                 Watermark="Введите описание заявки"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Разделитель -->
                    <Border Height="1" Background="#E0E0E0"/>

                    <!-- Клиент -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding ClientTitle}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#9FB8C4"/>

                        <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto">

                            <StackPanel Grid.Column="0" Grid.Row="0"
                                        Spacing="4" Margin="0,0,8,10">
                                <TextBlock Text="{Binding SurnameTitle}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="#9FB8C4"/>
                                <TextBox Text="{Binding SurnameText}"
                                         Watermark="Иванов"
                                         FontSize="13"
                                         CornerRadius="8"
                                         Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0"
                                        Spacing="4" Margin="8,0,0,10">
                                <TextBlock Text="{Binding FirstNameTitle}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="#9FB8C4"/>
                                <TextBox Text="{Binding FirstNameText}"
                                         Watermark="Иван"
                                         FontSize="13"
                                         CornerRadius="8"
                                         Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1"
                                        Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SecondNameTitle}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="#9FB8C4"/>
                                <TextBox Text="{Binding SecondNameText}"
                                         Watermark="Иванович"
                                         FontSize="13"
                                         CornerRadius="8"
                                         Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1"
                                        Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="{Binding PhonTitle}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="#9FB8C4"/>
                                <TextBox Text="{Binding PhonText}"
                                         Watermark="+7 (999) 000-00-00"
                                         FontSize="13"
                                         CornerRadius="8"
                                         Padding="12,8"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>

                    <!-- Разделитель -->
                    <Border Height="1" Background="#E0E0E0"/>

                    <!-- Недвижимость -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding RealEstateTitle}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                       <ComboBox ItemsSource="{Binding RealEstate}"
                                  SelectedItem=""
                                  FontSize="13"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8"
                                  Padding="12,8"/> 
                    </StackPanel>

                    <!-- Разделитель -->
                    <Border Height="1" Background="#E0E0E0"/>

                    <!-- Кнопка -->
                    <Button Content="Создать заявку"
                            
                            HorizontalAlignment="Right"
                            Background="#1A3C4D"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="16,9"
                            FontSize="13"/>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>