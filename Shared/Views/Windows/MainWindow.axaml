<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Windows"
        xmlns:pagesvm="using:AccountingAndAnalytics.Shared.ViewModels.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pagesv="using:AccountingAndAnalytics.Shared.Views.Pages"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AccountingAndAnalytics.Shared.Views.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MainWindow">

    <Window.DataTemplates>
        <DataTemplate
        DataType="pagesvm:HomeViewModel">
            <pagesv:HomeView/>
        </DataTemplate>
        <DataTemplate
        DataType="pagesvm:AuthorizationViewModel">
            <pagesv:AuthorizationView/>
        </DataTemplate>
        <DataTemplate
        DataType="pagesvm:ProfileViewModel">
            <pagesv:ProfileView/>
        </DataTemplate>
    </Window.DataTemplates>

    

    <Grid>
        <ContentControl
        Content="{Binding CurrentPage}" />
        <dialogHost:DialogHost Identifier="MainDialog" Background="Transparent">
    <!-- <ContentControl Content="{Binding CurrentPage}"/> -->
            
    </dialogHost:DialogHost>
        
    </Grid>

    </Window>