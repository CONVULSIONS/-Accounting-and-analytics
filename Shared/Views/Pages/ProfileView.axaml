<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Pages"
             xmlns:statisticVm="using:AccountingAndAnalytics.Analytics.ViewModels"
             xmlns:statisticV="using:AccountingAndAnalytics.Analytics.Views"
             x:DataType="vm:ProfileViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AccountingAndAnalytics.Shared.Views.Pages.ProfileView">

    <UserControl.DataTemplates>
        <DataTemplate DataType="statisticVm:StatisticViewModel">
            <statisticV:StatisticsView/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*" Background="#F4F6F9">

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="#1A3C4D"
                Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Button Grid.Column="0"
                        Content="←"
                        Command="{Binding BackCommand}"
                        Background="Transparent"
                        Foreground="White"
                        FontSize="20"
                        Padding="0,0,16,0"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <Border Width="56" Height="56"
                            Background="#2E6B8A"
                            CornerRadius="28">
                        <TextBlock Text="{Binding Initials}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="#9FE1CB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding Department}"
                                   FontSize="13"
                                   Foreground="#9FB8C4"/>
                        <TextBlock Text="{Binding Role}"
                                   FontSize="12"
                                   Foreground="#9FB8C4"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="{Binding LogoutLabel}"
                        Command="{Binding LogoutCommand}"
                        Background="#FCEBEB"
                        Foreground="#A32D2D"
                        CornerRadius="8"
                        Padding="16,8"
                        FontSize="13"
                        FontWeight="Medium"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,20,24,20" Spacing="16">
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,16">
                    <ContentControl Content="{Binding Statistic}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>