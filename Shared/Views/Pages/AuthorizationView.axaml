<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:AuthorizationViewModel"
             x:Class="AccountingAndAnalytics.Shared.Views.Pages.AuthorizationView">
   <Design.DataContext>
       <vm:AuthorizationViewModel/>
   </Design.DataContext>

    <!-- основной грид -->
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- бордер -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="AliceBlue"
                BorderBrush="LightBlue"
                BorderThickness="10,6"
                CornerRadius="10">

            <!-- грид авторизации -->
            <Grid ShowGridLines="False" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- содержимое -->
                <!-- заголовок авторизация -->
                <Viewbox
                Grid.Column="1" Grid.ColumnSpan="3"
                Grid.Row="1">
                    <TextBlock
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TextAlignment="Center"
                    Text="{Binding AuthTextblock}"
                    FontWeight="Bold"/>
                </Viewbox>

                <!-- надпись логин -->
                <Viewbox
                Grid.Column="1"
                Grid.Row="3">
                    <TextBlock
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TextAlignment="Center"
                    Margin="6,6,6,6"
                    Text="{Binding LoginTextblock}"/>
                </Viewbox>

                <!-- текстбокс логина -->
                <TextBox
                Grid.Column="2" Grid.ColumnSpan="2"
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="5,15,5,15"
                Text="{Binding LoginText}"/>

                <!-- надпись пароль -->
                <Viewbox
                Grid.Column="1"
                Grid.Row="5">
                    <TextBlock
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TextAlignment="Center"
                    Margin="6,6,6,6"
                    Text="{Binding PassTextblock}"/>
                </Viewbox>

                <!-- текстбокс пароля -->
                <TextBox
                Grid.Column="2" Grid.ColumnSpan="2"
                Grid.Row="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="5,15,5,15"
                Text="{Binding PassText}"/>

                <!-- кнопка авторизации -->
                <Viewbox
                Grid.Column="1" Grid.ColumnSpan="3"
                Grid.Row="7">
                    <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="10"
                    Margin="10,10,10,10"
                    Background="LightBlue"
                    Content="{Binding AuthButtonText}"
                    Command="{Binding AutorizeAsyncCommand}"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
