<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AccountingAndAnalytics.Shared.Views.Elements.PersonView">
      <Border Background="#F4F6F9"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="20"
            Padding="6,5">
        <StackPanel Orientation="Horizontal" Spacing="8">

            <Border Width="26" Height="26"
                    Background="#2E6B8A"
                    CornerRadius="13">
                <TextBlock Text="Initials"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="#9FE1CB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="FullName"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>

        </StackPanel>
    </Border>
</UserControl>
