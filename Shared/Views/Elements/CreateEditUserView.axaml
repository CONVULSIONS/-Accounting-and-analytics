<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Elements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CreateEditUserViewModel"
             x:Class="AccountingAndAnalytics.Shared.Views.Elements.CreateEditUserView">

    <Border Background="White"
            CornerRadius="12"
            Width="540">
        <StackPanel>

            <Border Background="#1A3C4D"
                    CornerRadius="12,12,0,0"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding  CloseCommand}"
                            Background="Transparent"
                            Foreground="#9FB8C4"
                            FontSize="16"
                            Padding="8,4"/>
                </Grid>
            </Border>

            <StackPanel Margin="24,20,24,24" Spacing="16">

                <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto,Auto">

                    <StackPanel Grid.Column="0" Grid.Row="0"
                                Spacing="6" Margin="0,0,12,12">
                        <TextBlock Text="ФАМИЛИЯ"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding Surname}"
                                 Watermark="Иванов"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0"
                                IsVisible="{Binding !IsEdit}"
                                Spacing="6" Margin="12,0,0,12">
                        <TextBlock Text="ОТДЕЛ"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <ComboBox ItemsSource="{Binding Departments}"
                                  SelectedItem="{Binding SelectedDepartment}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="13"
                                  CornerRadius="8"
                                  Padding="12,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1"
                                Spacing="6" Margin="0,0,12,12">
                        <TextBlock Text="ИМЯ"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding FirstName}"
                                 Watermark="Иван"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1"
                                IsVisible="{Binding !IsEdit}"
                                Spacing="6" Margin="12,0,0,12">
                        <TextBlock Text="РОЛЬ"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRole}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="13"
                                  CornerRadius="8"
                                  Padding="12,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2"
                                Spacing="6" Margin="0,0,12,0">
                        <TextBlock Text="ОТЧЕСТВО"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding SecondName}"
                                 Watermark="Иванович"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"/>
                    </StackPanel>

                </Grid>

                <Border Height="1" Background="#E0E0E0"/>

                <Border Height="1" Background="#E0E0E0"/>

                <Grid ColumnDefinitions="1*,1*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                        <TextBlock Text="ЛОГИН"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding Login}"
                                 Watermark="ivanov_i"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                        <TextBlock Text="ПАРОЛЬ"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#9FB8C4"/>
                        <TextBox Text="{Binding Password}"
                                 Watermark="••••••••"
                                 PasswordChar="●"
                                 FontSize="13"
                                 CornerRadius="8"
                                 Padding="12,8"/>
                    </StackPanel>
                </Grid>

                <Button Content="Готово"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Right"
                        Background="#1A3C4D"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="24,10"
                        FontSize="13"
                        FontWeight="Medium"/>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
