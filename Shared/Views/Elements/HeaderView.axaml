<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Elements"
             x:DataType="vm:HeaderViewModel"
             mc:Ignorable="d" 
             x:Class="AccountingAndAnalytics.Shared.Views.Elements.HeaderView">



<Grid ColumnDefinitions="Auto,*,Auto" Height="64"
          Background="#1A3C4D">

        <!-- Лого -->
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    Spacing="12" VerticalAlignment="Center" Margin="20,0">
            <TextBlock Text="Accounting and analytics"
                       FontSize="16" FontWeight="Medium"
                       Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Профиль -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    Spacing="10" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FullName"
                           FontSize="13" FontWeight="Medium"
                           Foreground="White"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="RoleName"
                           FontSize="11"
                           Foreground="#9FB8C4"
                           HorizontalAlignment="Right"/>
            </StackPanel>
            <Border Width="36" Height="36"
                    Background="#2E6B8A"
                    CornerRadius="18">
                <Button HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Foreground="#9FE1CB"
                        FontSize="11" FontWeight="Medium"
                        Content="Initials"
                        CornerRadius="18"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Command="{Binding OpenProfileCommand}"/>
            </Border>
        </StackPanel>
    </Grid>
    <!-- Text="{Binding FullName}"-->
    <!-- Text="{Binding RoleName}" -->
    <!-- Text="{Binding Initials}" -->
</UserControl>