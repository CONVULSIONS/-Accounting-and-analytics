<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:AccountingAndAnalytics.Shared.ViewModels.Elements"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Elements"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AccountingAndAnalytics.Shared.Views.Elements.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <Border Background="#3a5c6e">
        <StackPanel Width="{Binding SidebarWidth}">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width"
                                      Duration="0:0:0.25"
                                      Easing="CubicEaseOut"/>
                </Transitions>
            </StackPanel.Transitions>

            <!-- Кнопка сворачивания -->
            <Button HorizontalAlignment="Right"
                    Margin="8"
                    Foreground="White"
                    Background="Transparent"
                    Content="{Binding SidebarArrow}"
                    Command="{Binding ToggleSidebarCommand}"/>

            <!-- Навигация -->
            <Button Content="Application"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    Foreground="#9FB8C4"
                    Padding="16,10"
                    Command="{Binding GoToApplicationCommand}"/>
            <Button Content="Deals"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    Foreground="#9FB8C4"
                    Padding="16,10"
                    Command="{Binding GoToDealsCommand}"/>
        </StackPanel>
    </Border>
</UserControl>
