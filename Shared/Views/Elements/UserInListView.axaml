<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AccountingAndAnalytics.Shared.ViewModels.Elements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:UserInListViewModel"
             x:Class="AccountingAndAnalytics.Shared.Views.Elements.UserInListView">
    <Grid ColumnDefinitions="*,40">
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,8,0">
            <Grid ColumnDefinitions="Auto,*">

                <Border Grid.Column="0"
                        Width="44" Height="44"
                        Background="#2E6B8A"
                        CornerRadius="22"
                        Margin="0,0,16,0">
                    <TextBlock Text="Initials}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#9FE1CB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}"
                               FontSize="14"
                               FontWeight="Medium"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Отдел:"
                                       FontSize="12"
                                       Foreground="#9FB8C4"/>
                            <TextBlock Text="{Binding DepartmentName}"
                                       FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Должность:"
                                       FontSize="12"
                                       Foreground="#9FB8C4"/>
                            <TextBlock Text="{Binding RoleName}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <Button Command="{Binding EditCommand}"
                    Width="32" Height="32"
                    Padding="0"
                    CornerRadius="6"
                    Background="#1A3C4D"
                    HorizontalAlignment="Center">
                <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                          Width="14" Height="14"
                          Foreground="White"/>
            </Button>
            <Button Command="{Binding DeleteCommand}"
                    Width="32" Height="32"
                    Padding="0"
                    CornerRadius="6"
                    Background="#A32D2D"
                    HorizontalAlignment="Center">
                <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                          Width="14" Height="14"
                          Foreground="White"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
