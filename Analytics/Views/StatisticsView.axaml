<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charts="using:AccountingAndAnalytics.Analytics.Views"
             xmlns:vm="using:AccountingAndAnalytics.Analytics.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:StatisticViewModel"
             x:Class="AccountingAndAnalytics.Analytics.Views.StatisticsView">

    <Design.DataContext>
        <vm:StatisticViewModel/>
    </Design.DataContext>

    <StackPanel Spacing="20" Margin="16">

        <!-- Прогрессбар + счетчик -->
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding TaskSpeedLabel}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#6B7280"/>
            <ProgressBar Value="{Binding TasksCompletedPercent}"
                         Minimum="0"
                         Maximum="100"
                         Height="12"
                         CornerRadius="6"
                         Foreground="#0F6E56"
                         Background="#E0E0E0"
                         MaxWidth="300"
                         HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding TasksCompletedCount}"
                       FontSize="12"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- Диаграмма сделок -->
        <StackPanel Spacing="8" HorizontalAlignment="Left">
            <TextBlock Text="{Binding DealsChartLabel}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#6B7280"/>
            <Grid ColumnDefinitions="Auto,Auto">
                <charts:PieChartView Grid.Column="0"
                                     Width="160" Height="160"
                                     Slices="{Binding DealsSlices}"/>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="6" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="#0F6E56"/>
                        <TextBlock Text="{Binding DealsClosedLabel}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="#2E6B8A"/>
                        <TextBlock Text="{Binding DealsActiveLabel}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="#A32D2D"/>
                        <TextBlock Text="{Binding DealsCancelledLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

    </StackPanel>

</UserControl>